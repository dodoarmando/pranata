{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "chore(release): release${component} ${version}",
  "signoff": "github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>",
  "extra-files": [
    { "type": "toml", "path": "apps/api/Cargo.toml", "jsonpath": "$.package.version" },
    { "type": "json", "path": "apps/api/openapi.json", "jsonpath": "$.info.version" },
    {
      "type": "toml",
      "path": "Cargo.lock",
      "jsonpath": "$.package[?(@.name.value == 'pranata')].version"
    }
  ],
  "packages": { ".": {} }
}
