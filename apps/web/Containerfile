# Image `pranata-web`. Build context: the repository root.
FROM docker.io/oven/bun:1.4.4 AS build
WORKDIR /src
COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/
# --ignore-scripts: the root `prepare` installs git hooks, which need a git checkout.
RUN bun install --frozen-lockfile --ignore-scripts
COPY apps/web apps/web
RUN cd apps/web && bun run build \
    # The server bundle is self-contained; srvx (no dependencies) is the only runtime package.
    && cp -rL node_modules/srvx /srvx

FROM docker.io/oven/bun:1.4.4-slim
LABEL org.opencontainers.image.source=https://github.com/dodoarmando/pranata \
      org.opencontainers.image.licenses=AGPL-3.0-only
WORKDIR /app
COPY --from=build /src/apps/web/dist dist
COPY --from=build /srvx node_modules/srvx
USER bun
EXPOSE 3000
# `bun`, not the `node` shebang: the production runtime is Bun.
CMD ["bun", "node_modules/srvx/bin/srvx.mjs", "--prod", "-s", "../client", "dist/server/index.js"]
