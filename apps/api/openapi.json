{
	"openapi": "3.1.0",
	"info": {
		"title": "Pranata API",
		"description": "Village website and administration API.",
		"license": {
			"name": "AGPL-3.0-or-later",
			"identifier": "AGPL-3.0-or-later"
		},
		"version": "0.1.0"
	},
	"paths": {
		"/api/admin/media": {
			"post": {
				"tags": ["media"],
				"summary": "Upload an image or a document.",
				"description": "An image is accepted as `pending` and turns `ready` once its background job\nhas produced the metadata-free original and the WebP variants. The same\nfile (by SHA-256) answers 200 with the existing asset.\n\n# Errors\n413 `file_too_large`, 415 `unsupported_media_type`, 422 `image_too_large` or\n`image_unreadable`, 422 `validation_failed` for a bad form.",
				"operationId": "uploadMedia",
				"parameters": [
					{
						"name": "x-csrf-token",
						"in": "header",
						"description": "The CSRF token from sign-in",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"multipart/form-data": {
							"schema": {
								"$ref": "#/components/schemas/UploadForm"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "The same file was uploaded before; the existing asset",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/MediaAsset"
								}
							}
						}
					},
					"201": {
						"description": "A new asset",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/MediaAsset"
								}
							}
						}
					},
					"401": {
						"description": "Not signed in (code unauthenticated)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "Missing or wrong CSRF token (code csrf_mismatch), or a Role without village.manage and content.write (code permission_denied)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"413": {
						"description": "Over 10 MB for an image or 20 MB for a document (code file_too_large)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"415": {
						"description": "Not JPEG, PNG or WebP for an image, or not PDF for a document (code unsupported_media_type)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"422": {
						"description": "Over 50 megapixels (code image_too_large), an unreadable image (code image_unreadable) or a bad form (code validation_failed)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"session": []
					}
				]
			}
		},
		"/api/admin/media/{id}": {
			"get": {
				"tags": ["media"],
				"summary": "Read one asset.",
				"description": "# Errors\n404 `media_not_found`.",
				"operationId": "getMedia",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "Asset id",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"description": "The asset",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/MediaAsset"
								}
							}
						}
					},
					"401": {
						"description": "Not signed in (code unauthenticated)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "The Role has neither village.manage nor content.write (code permission_denied)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"404": {
						"description": "No such asset (code media_not_found)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"session": []
					}
				]
			}
		},
		"/api/admin/village/profile": {
			"get": {
				"tags": ["village"],
				"summary": "The editable part of the Village profile.",
				"description": "# Errors\n404 `village_not_initialized` before `pranata village init` has run.",
				"operationId": "getVillageProfile",
				"responses": {
					"200": {
						"description": "The overview and hero photo",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Profile"
								}
							}
						}
					},
					"401": {
						"description": "Not signed in (code unauthenticated)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "The Role lacks village.manage (code permission_denied)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"404": {
						"description": "The Village is not initialised yet (code village_not_initialized)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"session": []
					}
				]
			},
			"put": {
				"tags": ["village"],
				"summary": "Replace the overview and hero photo, then purge the public cache.",
				"description": "# Errors\n409 `stale_write`; 422 `validation_failed` (field `overview`) or\n`hero_not_ready`; 404 `village_not_initialized`.",
				"operationId": "putVillageProfile",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ProfileUpdate"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "The saved profile",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Profile"
								}
							}
						}
					},
					"400": {
						"description": "Body is not valid JSON (code invalid_json)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"401": {
						"description": "Not signed in (code unauthenticated)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "The Role lacks village.manage (code permission_denied)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"404": {
						"description": "The Village is not initialised yet (code village_not_initialized)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"409": {
						"description": "The profile changed since it was read (code stale_write)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"415": {
						"description": "Request is not marked as JSON (code json_required)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"422": {
						"description": "Invalid overview (code validation_failed, with field errors) or a hero that is not a ready image (code hero_not_ready)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"session": []
					}
				]
			}
		},
		"/api/auth/access-links/redeem": {
			"post": {
				"tags": ["auth"],
				"summary": "Set a password with an Access Link. The link works once.",
				"description": "# Errors\n404 `access_link_not_found`, 410 `access_link_used`,\n`access_link_revoked` or `access_link_expired`, 422 `password_length`.",
				"operationId": "setPasswordWithAccessLink",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/RedeemAccessLinkRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"204": {
						"description": "Password set; the link is used up"
					},
					"404": {
						"description": "Unknown link (code access_link_not_found)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"410": {
						"description": "Link used or expired (codes access_link_used, access_link_revoked, access_link_expired)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"415": {
						"description": "Request is not marked as JSON (code json_required)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"422": {
						"description": "Password length rule broken (code password_length)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"429": {
						"description": "Too many requests from this address (code too_many_requests); Retry-After gives the seconds to wait",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
		"/api/auth/login": {
			"post": {
				"tags": ["auth"],
				"summary": "Sign in with a username and password.",
				"description": "# Errors\n401 `invalid_credentials`, identical for an unknown user and a wrong\npassword; 429 `too_many_attempts` after ten failures in 15 minutes.",
				"operationId": "login",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/LoginRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "Signed in; the session cookie is set",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SessionInfo"
								}
							}
						}
					},
					"400": {
						"description": "Body is not valid JSON (code invalid_json)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"401": {
						"description": "Wrong username or password (code invalid_credentials)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"429": {
						"description": "Too many failed attempts for this account (code too_many_attempts) or too many requests from this address (code too_many_requests); Retry-After gives the seconds to wait",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
		"/api/auth/logout": {
			"post": {
				"tags": ["auth"],
				"summary": "End the current session.",
				"description": "# Errors\n401 `unauthenticated`; 403 `csrf_mismatch` without the CSRF header.",
				"operationId": "logout",
				"parameters": [
					{
						"name": "x-csrf-token",
						"in": "header",
						"description": "The CSRF token from sign-in",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"204": {
						"description": "Signed out; the session cookie is cleared"
					},
					"401": {
						"description": "Not signed in (code unauthenticated)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "Missing or wrong CSRF token (code csrf_mismatch)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"session": []
					}
				]
			}
		},
		"/api/auth/me": {
			"get": {
				"tags": ["auth"],
				"summary": "The signed-in User and their CSRF token.",
				"description": "# Errors\n401 `unauthenticated`.",
				"operationId": "getMe",
				"responses": {
					"200": {
						"description": "The current session",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SessionInfo"
								}
							}
						}
					},
					"401": {
						"description": "Not signed in (code unauthenticated)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"session": []
					}
				]
			}
		},
		"/api/auth/sudo": {
			"post": {
				"tags": ["auth"],
				"summary": "Confirm the password to open Sudo Mode for this session.",
				"description": "# Errors\n401 `invalid_credentials` for a wrong password; 403 `csrf_mismatch`\nwithout the CSRF header; 429 `too_many_attempts` for a locked account.",
				"operationId": "confirmSudo",
				"parameters": [
					{
						"name": "x-csrf-token",
						"in": "header",
						"description": "The CSRF token from sign-in",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SudoRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"204": {
						"description": "Password confirmed; Sudo Mode is open for 10 minutes"
					},
					"400": {
						"description": "Body is not valid JSON (code invalid_json)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"401": {
						"description": "Not signed in (code unauthenticated) or wrong password (code invalid_credentials)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "Missing or wrong CSRF token (code csrf_mismatch)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"415": {
						"description": "Request is not marked as JSON (code json_required)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"429": {
						"description": "Too many failed attempts for this account (code too_many_attempts); Retry-After gives the seconds to wait",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"session": []
					}
				]
			}
		},
		"/api/healthz": {
			"get": {
				"tags": ["ops"],
				"summary": "Liveness and version probe.",
				"operationId": "healthz",
				"responses": {
					"200": {
						"description": "The API is up",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Health"
								}
							}
						}
					}
				}
			}
		},
		"/api/public/village": {
			"get": {
				"tags": ["public"],
				"summary": "The Village profile shown on the public site.",
				"description": "# Errors\n404 `village_not_initialized` before `pranata village init` has run.",
				"operationId": "getPublicVillage",
				"responses": {
					"200": {
						"description": "The Village profile",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/VillageProfile"
								}
							}
						}
					},
					"404": {
						"description": "The Village is not initialised yet (code village_not_initialized)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
		"/api/readyz": {
			"get": {
				"tags": ["ops"],
				"summary": "Readiness probe for an external uptime check: the API is up and the\ndatabase answers. `/healthz` stays a pure liveness probe.",
				"description": "# Errors\n`Unavailable` (503 `database_unavailable`) when the database query fails or\ntakes longer than three seconds.",
				"operationId": "readyz",
				"responses": {
					"200": {
						"description": "The API is up and the database answers",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Ready"
								}
							}
						}
					},
					"503": {
						"description": "The database does not answer (code database_unavailable)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"CurrentUser": {
				"type": "object",
				"description": "The signed-in User, as an axum extractor. A missing or expired session\nanswers 401 `unauthenticated`.",
				"required": ["id", "username", "display_name", "role", "permissions"],
				"properties": {
					"display_name": {
						"type": "string"
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"permissions": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Permission"
						},
						"description": "What the Role grants, in catalogue order."
					},
					"role": {
						"$ref": "#/components/schemas/RoleRef"
					},
					"username": {
						"type": "string"
					}
				}
			},
			"FieldError": {
				"type": "object",
				"description": "One invalid field in a validation failure.",
				"required": ["field", "code"],
				"properties": {
					"code": {
						"type": "string"
					},
					"field": {
						"type": "string"
					}
				}
			},
			"Health": {
				"type": "object",
				"required": ["status", "version"],
				"properties": {
					"status": {
						"type": "string"
					},
					"version": {
						"type": "string"
					}
				}
			},
			"LoginRequest": {
				"type": "object",
				"required": ["username", "password"],
				"properties": {
					"password": {
						"type": "string"
					},
					"remember": {
						"type": "boolean",
						"description": "Keep the session for 30 days instead of until the browser closes."
					},
					"username": {
						"type": "string"
					}
				}
			},
			"MediaAsset": {
				"type": "object",
				"description": "An uploaded file as the admin API reports it.",
				"required": ["id", "kind", "status", "variants"],
				"properties": {
					"height": {
						"type": ["integer", "null"],
						"format": "int32"
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"kind": {
						"type": "string",
						"description": "`image` or `document`."
					},
					"status": {
						"type": "string",
						"description": "`pending` while the image job has not run, then `ready` or `failed`."
					},
					"variants": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/MediaVariant"
						},
						"description": "Public renditions, narrowest first; empty until `ready`, and always\nempty for documents."
					},
					"width": {
						"type": ["integer", "null"],
						"format": "int32",
						"description": "Width after the EXIF orientation is applied; unknown while `pending`."
					}
				}
			},
			"MediaRef": {
				"type": "object",
				"description": "An image as public responses embed it.",
				"required": ["id", "variants"],
				"properties": {
					"alt": {
						"type": ["string", "null"]
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"variants": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/MediaVariant"
						}
					}
				}
			},
			"MediaVariant": {
				"type": "object",
				"description": "One public WebP rendition of an image.",
				"required": ["width", "url"],
				"properties": {
					"url": {
						"type": "string",
						"description": "Site-relative URL, `/media/{hex[0..2]}/{hex}-{width}.webp`."
					},
					"width": {
						"type": "integer",
						"format": "int32"
					}
				}
			},
			"Permission": {
				"type": "string",
				"description": "One thing a User may be allowed to do.",
				"enum": [
					"village.manage",
					"content.write",
					"content.publish",
					"budget.manage",
					"audit.read",
					"user.manage",
					"role.manage"
				]
			},
			"Problem": {
				"type": "object",
				"description": "`RFC 9457` problem document returned for every error.",
				"required": ["type", "title", "status", "code"],
				"properties": {
					"code": {
						"type": "string",
						"description": "Stable machine-readable code (snake case)."
					},
					"errors": {
						"type": ["array", "null"],
						"items": {
							"$ref": "#/components/schemas/FieldError"
						}
					},
					"status": {
						"type": "integer",
						"format": "int32",
						"minimum": 0
					},
					"title": {
						"type": "string"
					},
					"type": {
						"type": "string"
					}
				}
			},
			"Profile": {
				"type": "object",
				"description": "What an Administrator edits.",
				"required": ["updated_at"],
				"properties": {
					"hero": {
						"oneOf": [
							{
								"$ref": "#/components/schemas/MediaRef"
							},
							{
								"type": "null"
							}
						]
					},
					"overview": {
						"type": ["object", "null"],
						"description": "`ProseMirror` document; `null` when there is no overview."
					},
					"updated_at": {
						"type": "string",
						"format": "date-time",
						"description": "Opaque value; send back exactly as received."
					}
				}
			},
			"ProfileUpdate": {
				"type": "object",
				"description": "The edit an Administrator submits.",
				"required": ["overview", "hero_asset_id", "updated_at"],
				"properties": {
					"hero_asset_id": {
						"type": ["string", "null"],
						"format": "uuid",
						"description": "A ready image asset, or `null` for no hero photo."
					},
					"overview": {
						"type": ["object", "null"],
						"description": "New overview, or `null` to clear it."
					},
					"updated_at": {
						"type": "string",
						"format": "date-time",
						"description": "Opaque value; send back exactly as received."
					}
				}
			},
			"Ready": {
				"type": "object",
				"required": ["status"],
				"properties": {
					"status": {
						"type": "string"
					}
				}
			},
			"RedeemAccessLinkRequest": {
				"type": "object",
				"description": "The Access Link token travels in the body, never in the URL, so request\nlogs and proxies cannot capture it.",
				"required": ["token", "password"],
				"properties": {
					"password": {
						"type": "string"
					},
					"token": {
						"type": "string"
					}
				}
			},
			"RoleRef": {
				"type": "object",
				"description": "The Role a User holds, as shown to clients.",
				"required": ["id", "name", "is_administrator"],
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"is_administrator": {
						"type": "boolean"
					},
					"name": {
						"type": "string"
					}
				}
			},
			"SessionInfo": {
				"type": "object",
				"description": "The signed-in User and the CSRF token to send as `x-csrf-token`.",
				"required": ["user", "csrf_token"],
				"properties": {
					"csrf_token": {
						"type": "string"
					},
					"sudo_until": {
						"type": ["string", "null"],
						"format": "date-time",
						"description": "When Sudo Mode closes (RFC 3339); null when the window is closed or was\nnever opened."
					},
					"user": {
						"$ref": "#/components/schemas/CurrentUser"
					}
				}
			},
			"SudoRequest": {
				"type": "object",
				"required": ["password"],
				"properties": {
					"password": {
						"type": "string"
					}
				}
			},
			"UploadForm": {
				"type": "object",
				"description": "The multipart form of an upload.",
				"required": ["file"],
				"properties": {
					"file": {
						"type": "string",
						"format": "binary",
						"description": "The file. JPEG, PNG or WebP up to 10 MB for `image`; PDF up to 20 MB\nfor `document`. The type is recognised from the content."
					},
					"kind": {
						"type": ["string", "null"],
						"description": "`image` (default) or `document`."
					}
				}
			},
			"VillageProfile": {
				"type": "object",
				"description": "What the public site shows about the Village.",
				"required": [
					"code",
					"name",
					"district",
					"regency",
					"province",
					"time_zone"
				],
				"properties": {
					"code": {
						"type": "string",
						"description": "Dotted 10-digit village code."
					},
					"district": {
						"type": "string"
					},
					"hero": {
						"oneOf": [
							{
								"$ref": "#/components/schemas/MediaRef",
								"description": "Hero photo; `null` until an Administrator picks one."
							},
							{
								"type": "null"
							}
						]
					},
					"name": {
						"type": "string"
					},
					"overview_html": {
						"type": ["string", "null"],
						"description": "The overview as sanitized HTML; `null` until an Administrator writes\none."
					},
					"province": {
						"type": "string"
					},
					"regency": {
						"type": "string"
					},
					"time_zone": {
						"type": "string",
						"description": "IANA time zone name."
					}
				}
			}
		},
		"securitySchemes": {
			"session": {
				"type": "apiKey",
				"in": "cookie",
				"name": "pranata_session"
			}
		}
	}
}
