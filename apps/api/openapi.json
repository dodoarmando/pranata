{
  "openapi": "3.1.0",
  "info": {
    "title": "Pranata API",
    "description": "",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/audit-entries": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "The Audit Log, newest first, filtered and a page at a time.",
        "description": "# Errors\n`401` without a live session, `403` without `audit.read`.",
        "operationId": "listAuditEntries",
        "parameters": [
          {
            "name": "objectType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "objectId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "username",
            "in": "query",
            "description": "The acting User's username.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "The first day, in the Village's time zone.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "The last day, inclusive, in the Village's time zone.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "before",
            "in": "query",
            "description": "The `next` of the previous page.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of matching Audit Entries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          },
          "403": {
            "description": "The User may not read the Audit Log"
          }
        }
      }
    },
    "/auth/access-link": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sets the User's password from their Access Link, which is then used up, and revokes every\nsession of theirs.",
        "description": "# Errors\n`404` for an unknown, used or expired link, `422` for a refused password.",
        "operationId": "useAccessLink",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UseAccessLink"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The password is set and every session of the User revoked"
          },
          "404": {
            "description": "The Access Link is unknown, used or expired"
          },
          "422": {
            "description": "The password is refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordRejected"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in User.",
        "description": "# Errors\n`401` without a live session.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "The signed-in User",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          }
        }
      }
    },
    "/auth/passkeys": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in User's passkeys, oldest first.",
        "description": "# Errors\n`401` without a live session.",
        "operationId": "listPasskeys",
        "responses": {
          "200": {
            "description": "The User's passkeys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PasskeySummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          }
        }
      },
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Finishes adding a passkey for the signed-in User.",
        "description": "# Errors\n`400` for a credential that fails verification, `401` without a live session, `404` for an\nunknown, used or expired ceremony or one another User started, `409` for a credential\nalready registered, `422` for a missing or over-long name, `428` outside sudo mode.",
        "operationId": "createPasskey",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPasskey"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The passkey is added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeySummary"
                }
              }
            }
          },
          "400": {
            "description": "The credential fails verification"
          },
          "401": {
            "description": "There is no live session"
          },
          "404": {
            "description": "The ceremony is unknown, used or expired"
          },
          "409": {
            "description": "The credential is already registered"
          },
          "422": {
            "description": "The name is missing or too long"
          },
          "428": {
            "description": "The User must re-authenticate first"
          }
        }
      }
    },
    "/auth/passkeys/registration": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Starts adding a passkey for the signed-in User, excluding the ones they already have.",
        "description": "# Errors\n`401` without a live session, `428` outside sudo mode, `503` with too many ceremonies in flight.",
        "operationId": "startPasskeyRegistration",
        "responses": {
          "200": {
            "description": "The options for `navigator.credentials.create`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasskeyChallenge"
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          },
          "428": {
            "description": "The User must re-authenticate first"
          },
          "503": {
            "description": "Too many ceremonies are in flight; try again"
          }
        }
      }
    },
    "/auth/passkeys/{id}": {
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Removes one of the signed-in User's passkeys.",
        "description": "# Errors\n`401` without a live session, `404` for a passkey that is not theirs, `428` outside sudo mode.",
        "operationId": "deletePasskey",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The passkey",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The passkey is removed"
          },
          "401": {
            "description": "There is no live session"
          },
          "404": {
            "description": "The User has no such passkey"
          },
          "428": {
            "description": "The User must re-authenticate first"
          }
        }
      }
    },
    "/auth/password": {
      "put": {
        "tags": [
          "auth"
        ],
        "summary": "Changes the signed-in User's password, under the same policy as at set-up, and ends every\nother session of theirs.",
        "description": "# Errors\n`401` without a live session, `422` for a refused password, `428` outside sudo mode.",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPassword"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The password is changed and every other session ended"
          },
          "401": {
            "description": "There is no live session"
          },
          "422": {
            "description": "The password is refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordRejected"
                }
              }
            }
          },
          "428": {
            "description": "The User must re-authenticate first"
          }
        }
      }
    },
    "/auth/reauthenticate": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Confirms the signed-in User's password, entering sudo mode for 15 minutes.",
        "description": "# Errors\n`401` without a live session or for a wrong password.",
        "operationId": "reauthenticate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reauthenticate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The password is right; sudo mode starts"
          },
          "401": {
            "description": "There is no live session, or the password is wrong"
          }
        }
      }
    },
    "/auth/sessions": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in User's live sessions, most recently active first.",
        "description": "# Errors\n`401` without a live session.",
        "operationId": "listSessions",
        "responses": {
          "200": {
            "description": "The User's live sessions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActiveSession"
                  }
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          }
        }
      }
    },
    "/auth/sign-in": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with a username and password, starting a session held in the `__Host-session` cookie.",
        "description": "# Errors\n`401`, the same for every wrong username or password.",
        "operationId": "signIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Signed in; the response sets the session cookie"
          },
          "401": {
            "description": "The username or password is wrong"
          }
        }
      }
    },
    "/auth/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Ends the current session and clears its cookie.",
        "description": "# Errors\n`401` without a live session.",
        "operationId": "signOut",
        "responses": {
          "204": {
            "description": "Signed out; the response clears the session cookie"
          },
          "401": {
            "description": "There is no live session"
          }
        }
      }
    },
    "/auth/sign-out-others": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "\"Keluar dari perangkat lain\": ends every session of the User but the current one.",
        "description": "# Errors\n`401` without a live session.",
        "operationId": "signOutOthers",
        "responses": {
          "204": {
            "description": "Every other session of the User is ended"
          },
          "401": {
            "description": "There is no live session"
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "The admin dashboard's figures, for any signed-in User.",
        "description": "# Errors\n`401` without a live session.",
        "operationId": "getDashboard",
        "responses": {
          "200": {
            "description": "The dashboard's figures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Reports whether the API can reach its database.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The API and its database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/roles": {
      "get": {
        "tags": [
          "roles"
        ],
        "summary": "Every Role, the Administrator first.",
        "description": "# Errors\n`401` without a live session, `403` outside the Administrator Role.",
        "operationId": "listRoles",
        "responses": {
          "200": {
            "description": "Every Role",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Role"
                  }
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          },
          "403": {
            "description": "The User is not an Administrator"
          }
        }
      },
      "post": {
        "tags": [
          "roles"
        ],
        "summary": "Creates a Role from the Permission catalog.",
        "description": "# Errors\n`401` without a live session, `403` outside the Administrator Role, `409` for a taken\nname, `428` outside sudo mode, `422` for a blank name or a Permission outside the catalog.",
        "operationId": "createRole",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The new Role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          },
          "403": {
            "description": "The User is not an Administrator"
          },
          "409": {
            "description": "Another Role has the name"
          },
          "422": {
            "description": "The name is blank or a Permission is unknown"
          },
          "428": {
            "description": "The User must re-authenticate first"
          }
        }
      }
    },
    "/roles/{id}": {
      "put": {
        "tags": [
          "roles"
        ],
        "summary": "Renames a Role and replaces its Permissions; its Users hold them from their next request.",
        "description": "# Errors\n`401` without a live session, `403` outside the Administrator Role, `404` for an unknown\nRole, `409` for the locked Administrator Role or a taken name, `428` outside sudo mode,\n`422` as for creating.",
        "operationId": "updateRole",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The Role",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The Role is changed"
          },
          "401": {
            "description": "There is no live session"
          },
          "403": {
            "description": "The User is not an Administrator"
          },
          "404": {
            "description": "There is no such Role"
          },
          "409": {
            "description": "The Role is the Administrator, or another Role has the name"
          },
          "422": {
            "description": "The name is blank or a Permission is unknown"
          },
          "428": {
            "description": "The User must re-authenticate first"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Every User, oldest first.",
        "description": "# Errors\n`401` without a live session, `403` outside the Administrator Role.",
        "operationId": "listUsers",
        "responses": {
          "200": {
            "description": "Every User",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          },
          "403": {
            "description": "The User is not an Administrator"
          }
        }
      },
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Creates a User and their first Access Link.",
        "description": "# Errors\n`401` without a live session, `403` outside the Administrator Role, `409` for a taken\nusername, `422` for a malformed username or an unknown Role, `428` outside sudo mode.",
        "operationId": "createUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The User and their Access Link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessLink"
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          },
          "403": {
            "description": "The User is not an Administrator"
          },
          "409": {
            "description": "The username is taken"
          },
          "422": {
            "description": "The username is malformed or the Role unknown"
          },
          "428": {
            "description": "The User must re-authenticate first"
          }
        }
      }
    },
    "/users/{id}": {
      "patch": {
        "tags": [
          "users"
        ],
        "summary": "Changes a User's Role or deactivates or reactivates them, never leaving the Village without\nan active Administrator.",
        "description": "# Errors\n`401` without a live session, `403` outside the Administrator Role, `404` for an unknown\nUser, `409` when no active Administrator would remain, `422` for an unknown Role, `428`\noutside sudo mode.",
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The User",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The User is changed"
          },
          "401": {
            "description": "There is no live session"
          },
          "403": {
            "description": "The User is not an Administrator"
          },
          "404": {
            "description": "There is no such User"
          },
          "409": {
            "description": "It would leave no active Administrator"
          },
          "422": {
            "description": "The Role is unknown"
          },
          "428": {
            "description": "The User must re-authenticate first"
          }
        }
      }
    },
    "/users/{id}/access-link": {
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Resets a User's access: a new Access Link that voids the previous one, and every session\nof theirs revoked.",
        "description": "# Errors\n`401` without a live session, `403` outside the Administrator Role, `404` for an unknown\nUser, `409` for an inactive User, `428` outside sudo mode.",
        "operationId": "createAccessLink",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The User",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The new Access Link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessLink"
                }
              }
            }
          },
          "401": {
            "description": "There is no live session"
          },
          "403": {
            "description": "The User is not an Administrator"
          },
          "404": {
            "description": "There is no such User"
          },
          "409": {
            "description": "The User is inactive"
          },
          "428": {
            "description": "The User must re-authenticate first"
          }
        }
      }
    },
    "/users/{id}/sessions": {
      "delete": {
        "tags": [
          "users"
        ],
        "summary": "Signs a User out everywhere by revoking every session of theirs.",
        "description": "# Errors\n`401` without a live session, `403` outside the Administrator Role, `404` for an unknown\nUser, `428` outside sudo mode.",
        "operationId": "revokeSessions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The User",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Every session of the User is revoked"
          },
          "401": {
            "description": "There is no live session"
          },
          "403": {
            "description": "The User is not an Administrator"
          },
          "404": {
            "description": "There is no such User"
          },
          "428": {
            "description": "The User must re-authenticate first"
          }
        }
      }
    },
    "/village": {
      "get": {
        "tags": [
          "village"
        ],
        "summary": "The Village's official identity; read-only, set by the vendor from the CLI.",
        "description": "# Errors\n`404` before the Village Code is set, `500` when the database is unreachable.",
        "operationId": "getVillage",
        "responses": {
          "200": {
            "description": "The Village",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Village"
                }
              }
            }
          },
          "404": {
            "description": "The Village Code is not set yet"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessLink": {
        "type": "object",
        "description": "A fresh Access Link, shown once: the web app links to `/akses#<token>`.",
        "required": [
          "userId",
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Single-use and valid for 24 hours."
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ActiveSession": {
        "type": "object",
        "required": [
          "lastSeenAt",
          "current"
        ],
        "properties": {
          "current": {
            "type": "boolean",
            "description": "Whether this is the session making the request."
          },
          "ip": {
            "type": [
              "string",
              "null"
            ],
            "description": "The address signed in from."
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "userAgent": {
            "type": [
              "string",
              "null"
            ],
            "description": "The browser's user agent at sign-in."
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "required": [
          "id",
          "at",
          "actor",
          "action",
          "objectType",
          "details",
          "changes"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "description": "`user`, `system` (the CLI) or `anonymous` (not identified)."
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldChange"
            },
            "description": "The per-field diff of a data change."
          },
          "details": {
            "description": "Context for the action; never sensitive values, which go in `changes` to be masked."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "objectId": {
            "type": [
              "string",
              "null"
            ]
          },
          "objectType": {
            "type": "string"
          },
          "username": {
            "type": [
              "string",
              "null"
            ],
            "description": "The acting User's username, when the actor is a User."
          }
        }
      },
      "AuditPage": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            },
            "description": "At most 50 Audit Entries, newest first."
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Pass as `before` for the next, older page; null on the last page."
          }
        }
      },
      "Dashboard": {
        "type": "object",
        "description": "The figures behind the admin dashboard's cards.",
        "required": [
          "activeUsers"
        ],
        "properties": {
          "activeUsers": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "FieldChange": {
        "type": "object",
        "description": "One field's change in an Audit Entry.",
        "required": [
          "field",
          "from",
          "to"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "from": {},
          "sensitive": {
            "type": "boolean",
            "description": "Whether `from` and `to` are shown as `•••` to readers without `resident.sensitive`."
          },
          "to": {}
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok",
          "unavailable"
        ]
      },
      "Me": {
        "type": "object",
        "required": [
          "username",
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "The name of the User's Role."
          },
          "username": {
            "type": "string"
          }
        }
      },
      "NewPasskey": {
        "type": "object",
        "required": [
          "ceremonyId",
          "name",
          "credential"
        ],
        "properties": {
          "ceremonyId": {
            "type": "string",
            "format": "uuid"
          },
          "credential": {
            "type": "object",
            "description": "`PublicKeyCredential.toJSON()` of the created credential."
          },
          "name": {
            "type": "string",
            "description": "1–64 characters, such as the device it lives on."
          }
        }
      },
      "NewPassword": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "NewUser": {
        "type": "object",
        "required": [
          "username",
          "roleId"
        ],
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "description": "3–32 lowercase letters, digits, dots, underscores or dashes; never changed or reused."
          }
        }
      },
      "PasskeyChallenge": {
        "type": "object",
        "description": "A WebAuthn ceremony's options for the browser, and its id to finish it with.",
        "required": [
          "ceremonyId",
          "options"
        ],
        "properties": {
          "ceremonyId": {
            "type": "string",
            "format": "uuid"
          },
          "options": {
            "description": "The ceremony options as JSON; `publicKey` goes to `PublicKeyCredential.parse…OptionsFromJSON`."
          }
        }
      },
      "PasskeySummary": {
        "type": "object",
        "required": [
          "id",
          "name",
          "createdAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "lastUsedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When it last signed the User in; null if never."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PasswordProblem": {
        "type": "string",
        "description": "Why a new password is refused.",
        "enum": [
          "tooShort",
          "tooLong",
          "common",
          "containsUsername",
          "containsVillageName"
        ]
      },
      "PasswordRejected": {
        "type": "object",
        "required": [
          "problem"
        ],
        "properties": {
          "problem": {
            "$ref": "#/components/schemas/PasswordProblem"
          }
        }
      },
      "Permission": {
        "type": "string",
        "description": "The fixed catalog of Permissions a Role can hold. Managing Users and Roles is not one:\nit belongs to the Administrator Role alone.",
        "enum": [
          "village.manage",
          "content.write",
          "content.publish",
          "complaint.read",
          "complaint.handle",
          "audit.read"
        ]
      },
      "Reauthenticate": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "Role": {
        "type": "object",
        "required": [
          "id",
          "name",
          "administrator",
          "permissions"
        ],
        "properties": {
          "administrator": {
            "type": "boolean",
            "description": "The built-in, locked Administrator Role, which holds every Permission whatever `permissions` says."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        }
      },
      "RoleInput": {
        "type": "object",
        "required": [
          "name",
          "permissions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique among Roles; surrounding spaces are dropped."
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        }
      },
      "SignIn": {
        "type": "object",
        "required": [
          "username",
          "password",
          "remember"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "remember": {
            "type": "boolean",
            "description": "\"Ingat saya\": 7 days idle and 30 days absolute instead of 30 minutes and 12 hours."
          },
          "username": {
            "type": "string"
          }
        }
      },
      "TimeZone": {
        "type": "string",
        "description": "Indonesia's three time zones; the Village's drives every date-only rule.",
        "enum": [
          "WIB",
          "WITA",
          "WIT"
        ]
      },
      "UseAccessLink": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "description": "The token after `#` in the Access Link."
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "username",
          "roleId",
          "role",
          "active"
        ],
        "properties": {
          "active": {
            "type": "boolean",
            "description": "False once deactivated: the User can neither sign in nor keep a session."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "description": "The name of the User's Role."
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "UserChange": {
        "type": "object",
        "properties": {
          "active": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "`false` deactivates the User, revoking every session of theirs at once; `true` reactivates."
          },
          "roleId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The User's new Role, held from their next request."
          }
        }
      },
      "Village": {
        "type": "object",
        "required": [
          "code",
          "name",
          "district",
          "regency",
          "province",
          "timeZone"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The 10-digit Village Code."
          },
          "district": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "regency": {
            "type": "string"
          },
          "timeZone": {
            "$ref": "#/components/schemas/TimeZone"
          }
        }
      }
    }
  }
}
