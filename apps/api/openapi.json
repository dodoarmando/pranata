{
	"openapi": "3.1.0",
	"info": {
		"title": "Pranata API",
		"description": "Village website and administration API.",
		"license": {
			"name": "AGPL-3.0-or-later",
			"identifier": "AGPL-3.0-or-later"
		},
		"version": "0.1.0"
	},
	"paths": {
		"/api/auth/access-links/redeem": {
			"post": {
				"tags": ["auth"],
				"summary": "Set a password with an Access Link. The link works once.",
				"description": "# Errors\n404 `access_link_not_found`, 410 `access_link_used` or\n`access_link_expired`, 422 `password_length`.",
				"operationId": "setPasswordWithAccessLink",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/RedeemAccessLinkRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"204": {
						"description": "Password set; the link is used up"
					},
					"404": {
						"description": "Unknown link (code access_link_not_found)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"410": {
						"description": "Link used or expired (codes access_link_used, access_link_expired)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"422": {
						"description": "Password length rule broken (code password_length)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
		"/api/auth/login": {
			"post": {
				"tags": ["auth"],
				"summary": "Sign in with a username and password.",
				"description": "# Errors\n401 `invalid_credentials`, identical for an unknown user and a wrong\npassword.",
				"operationId": "login",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/LoginRequest"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "Signed in; the session cookie is set",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SessionInfo"
								}
							}
						}
					},
					"401": {
						"description": "Wrong username or password (code invalid_credentials)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
		"/api/auth/logout": {
			"post": {
				"tags": ["auth"],
				"summary": "End the current session.",
				"description": "# Errors\n401 `unauthenticated`; 403 `csrf_mismatch` without the CSRF header.",
				"operationId": "logout",
				"parameters": [
					{
						"name": "x-csrf-token",
						"in": "header",
						"description": "The CSRF token from sign-in",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"204": {
						"description": "Signed out; the session cookie is cleared"
					},
					"401": {
						"description": "Not signed in (code unauthenticated)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "Missing or wrong CSRF token (code csrf_mismatch)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"session": []
					}
				]
			}
		},
		"/api/auth/me": {
			"get": {
				"tags": ["auth"],
				"summary": "The signed-in User and their CSRF token.",
				"description": "# Errors\n401 `unauthenticated`.",
				"operationId": "getMe",
				"responses": {
					"200": {
						"description": "The current session",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SessionInfo"
								}
							}
						}
					},
					"401": {
						"description": "Not signed in (code unauthenticated)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"session": []
					}
				]
			}
		},
		"/api/healthz": {
			"get": {
				"tags": ["ops"],
				"summary": "Liveness and version probe.",
				"operationId": "healthz",
				"responses": {
					"200": {
						"description": "The API is up",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Health"
								}
							}
						}
					}
				}
			}
		},
		"/api/public/village": {
			"get": {
				"tags": ["public"],
				"summary": "The Village profile shown on the public site.",
				"description": "# Errors\n404 `village_not_initialized` before `pranata village init` has run.",
				"operationId": "getPublicVillage",
				"responses": {
					"200": {
						"description": "The Village profile",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/VillageProfile"
								}
							}
						}
					},
					"404": {
						"description": "The Village is not initialised yet (code village_not_initialized)",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"CurrentUser": {
				"type": "object",
				"description": "The signed-in User, as an axum extractor. A missing or expired session\nanswers 401 `unauthenticated`.",
				"required": ["id", "username", "display_name"],
				"properties": {
					"display_name": {
						"type": "string"
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"username": {
						"type": "string"
					}
				}
			},
			"FieldError": {
				"type": "object",
				"description": "One invalid field in a validation failure.",
				"required": ["field", "code"],
				"properties": {
					"code": {
						"type": "string"
					},
					"field": {
						"type": "string"
					}
				}
			},
			"Health": {
				"type": "object",
				"required": ["status", "version"],
				"properties": {
					"status": {
						"type": "string"
					},
					"version": {
						"type": "string"
					}
				}
			},
			"LoginRequest": {
				"type": "object",
				"required": ["username", "password"],
				"properties": {
					"password": {
						"type": "string"
					},
					"remember": {
						"type": "boolean",
						"description": "Keep the session for 30 days instead of until the browser closes."
					},
					"username": {
						"type": "string"
					}
				}
			},
			"Problem": {
				"type": "object",
				"description": "`RFC 9457` problem document returned for every error.",
				"required": ["type", "title", "status", "code"],
				"properties": {
					"code": {
						"type": "string",
						"description": "Stable machine-readable code (snake case)."
					},
					"errors": {
						"type": ["array", "null"],
						"items": {
							"$ref": "#/components/schemas/FieldError"
						}
					},
					"status": {
						"type": "integer",
						"format": "int32",
						"minimum": 0
					},
					"title": {
						"type": "string"
					},
					"type": {
						"type": "string"
					}
				}
			},
			"RedeemAccessLinkRequest": {
				"type": "object",
				"description": "The Access Link token travels in the body, never in the URL, so request\nlogs and proxies cannot capture it.",
				"required": ["token", "password"],
				"properties": {
					"password": {
						"type": "string"
					},
					"token": {
						"type": "string"
					}
				}
			},
			"SessionInfo": {
				"type": "object",
				"description": "The signed-in User and the CSRF token to send as `x-csrf-token`.",
				"required": ["user", "csrf_token"],
				"properties": {
					"csrf_token": {
						"type": "string"
					},
					"user": {
						"$ref": "#/components/schemas/CurrentUser"
					}
				}
			},
			"VillageProfile": {
				"type": "object",
				"description": "What the public site shows about the Village.",
				"required": [
					"code",
					"name",
					"district",
					"regency",
					"province",
					"time_zone"
				],
				"properties": {
					"code": {
						"type": "string",
						"description": "Dotted 10-digit village code."
					},
					"district": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"province": {
						"type": "string"
					},
					"regency": {
						"type": "string"
					},
					"time_zone": {
						"type": "string",
						"description": "IANA time zone name."
					}
				}
			}
		},
		"securitySchemes": {
			"session": {
				"type": "apiKey",
				"in": "cookie",
				"name": "pranata_session"
			}
		}
	}
}
