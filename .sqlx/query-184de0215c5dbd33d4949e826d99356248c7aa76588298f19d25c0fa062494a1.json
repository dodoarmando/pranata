  "query": "SELECT s.csrf_token, s.remember, s.last_seen_at, s.expires_at,\n                  u.id AS \"user_id: UserId\", u.username, u.display_name\n           FROM sessions s JOIN users u ON u.id = s.user_id\n           WHERE s.token_hash = $1 AND u.is_active",
