  "query": "SELECT u.id AS \"id: UserId\",\n                  (u.password_hash IS NOT NULL\n                   OR EXISTS (SELECT 1 FROM passkeys p WHERE p.user_id = u.id)) AS \"has_credential!\"\n           FROM users u\n           WHERE u.id = ANY($1)\n           ORDER BY u.id",
