  "query": "SELECT a.id, v.width, v.path\n         FROM media_assets a\n         JOIN media_variants v ON v.asset_id = a.id\n         WHERE a.id = ANY($1) AND a.kind = 'image' AND a.status = 'ready'\n         ORDER BY a.id, v.width",
