# Managed by Ansible. The routes match infra/dev/Caddyfile.
# Caddy runs on the host network and the api and web publish on 127.0.0.1
# (ADR 0009). No trusted proxies: Caddy then replaces any X-Forwarded-For a
# client sends with the client's address, which the api relies on (D-34).
{
	admin off
	http_port {{ pranata_http_port }}
	https_port {{ pranata_https_port }}
	# Only 443/tcp is opened in the firewall, so do not advertise HTTP/3.
	servers {
		protocols h1 h2
	}
}

{{ pranata_domain }} {
{% if pranata_tls == 'internal' %}
	tls internal
{% endif %}
	encode zstd gzip

	# D-36 on every response. `?` sets a header only when the upstream has not,
	# so /api responses keep the single value the API sends.
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Variants are content-addressed, so they never change under their URL.
	handle_path /media/* {
		root * /srv/media/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The cache purge hook is for the API only, never for the internet.
	handle /_internal/* {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
