PRANATA_DATABASE_URL=postgres://pranata_app:{{ pranata_db_app_password | urlencode | replace('/', '%2F') }}@postgres:5432/pranata
PRANATA_MIGRATION_DATABASE_URL=postgres://pranata_owner:{{ pranata_db_owner_password | urlencode | replace('/', '%2F') }}@postgres:5432/pranata
PRANATA_PUBLIC_ORIGIN=https://{{ pranata_domain }}{{ '' if pranata_https_port == 443 else ':' ~ pranata_https_port }}
PRANATA_WEB_INTERNAL_URL=http://web:3000
PRANATA_PURGE_TOKEN={{ pranata_purge_token }}
PRANATA_MEDIA_DIR=/media
PRANATA_LISTEN=0.0.0.0:8080
