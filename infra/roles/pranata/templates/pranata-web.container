# Managed by Ansible.
[Unit]
Description=Pranata web
Wants=pranata-api.service
After=pranata-api.service

[Container]
Image={{ pranata_image_registry }}/pranata-web:{{ pranata_release }}
ContainerName=pranata-web
Network=pranata.network
NetworkAlias=web
EnvironmentFile=%h/.config/pranata/web.env
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
RestartSec=3
TimeoutStartSec=120

[Install]
WantedBy=default.target
