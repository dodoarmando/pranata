# Edge routing for the end-to-end stack. infra/roles/pranata/templates/Caddyfile.j2
# must keep the same routes (infra/check.sh compares them). Inside the pod the
# api and web listen on 127.0.0.1; on an Installation they publish there for
# Caddy, which runs on the host network (ADR 0009).
{
	admin off
	auto_https disable_redirects
	# Only 443/tcp is published, so do not advertise HTTP/3.
	servers {
		protocols h1 h2
	}
}

https://localhost {
	tls internal
	encode zstd gzip

	# D-36 on every response. `?` sets a header only when the upstream has not,
	# so /api responses keep the single value the API sends.
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Variants are content-addressed, so they never change under their URL.
	handle_path /media/* {
		root * /srv/media/public
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The cache purge hook is for the API only, never for the internet.
	handle /_internal/* {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
