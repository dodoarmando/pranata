# Two targets on Debian 13, the production target:
#   quadlet  Podman only, to dry-run the Quadlet units (`just check-infra`).
#   (final)  systemd, to run infra/provision.yml against (`just infra-test`,
#            with --privileged --systemd=always).
FROM docker.io/library/debian:13 AS base
ENV container=podman DEBIAN_FRONTEND=noninteractive

FROM base AS quadlet
RUN apt-get update \
    && apt-get install -y --no-install-recommends podman \
    && rm -rf /var/lib/apt/lists/*

FROM base
RUN apt-get update \
    && apt-get install -y --no-install-recommends systemd systemd-sysv dbus sudo python3 \
       ca-certificates iproute2 procps kmod \
    && rm -rf /var/lib/apt/lists/* \
    && systemctl mask getty.target console-getty.service \
       systemd-udev-trigger.service systemd-udevd.service

# The container's own storage is an overlay mount, which cannot hold another
# overlay, so the nested rootless Podman uses the vfs driver.
RUN mkdir -p /etc/containers \
    && printf '[storage]\ndriver = "vfs"\n' > /etc/containers/storage.conf

# A rootless container's user namespace maps only 65537 ids, so the nested
# user's subordinate ids must fit inside it, and must not include the user's
# own ids. The test inventory gives that user uid and gid 65536 (useradd does
# not allocate subordinate ids for it), so the whole range 1-65535 is free.
RUN echo 'pranata:1:65535' | tee /etc/subuid > /etc/subgid

# No network manager runs in the container, so nothing would activate
# network-online.target, which the Quadlet units wait for.
RUN systemctl add-wants multi-user.target network-online.target

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
