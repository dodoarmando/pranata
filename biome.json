{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!apps/api/openapi.json",
      "!**/src/api/generated.ts",
      "!**/src/routeTree.gen.ts",
      "!CHANGELOG.md",
      "!.release-please-manifest.json"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/src/routes/_public.tsx", "apps/web/src/routes/_public/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tiptap/*", "**/rich-text", "**/components/rich-text-editor"],
                    "message": "Public pages never ship Tiptap: render rich text in a server function with a dynamic import of rich-text-html."
                  },
                  {
                    "group": [
                      "**/admin/**",
                      "**/components/admin",
                      "**/sudo",
                      "**/autosave",
                      "**/device",
                      "**/order"
                    ],
                    "message": "Admin code never loads on public pages (performance budget)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
