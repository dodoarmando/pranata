{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!bun.lock",
			"!**/*.md",
			"!**/routeTree.gen.ts",
			"!**/generated",
			"!.sqlx"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"plugins": [
		{
			"path": "./biome-plugins/no-raw-controls.grit",
			"includes": ["apps/web/src/**", "!apps/web/src/components/ui/**"]
		}
	],
	"overrides": [
		{
			"includes": [
				"apps/web/src/routes/**",
				"!apps/web/src/routes/admin/**",
				"!apps/web/src/routes/admin.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/admin",
											"@/admin/**",
											"@/routes/admin",
											"@/routes/admin/**",
											"./admin",
											"./admin/**",
											"../admin",
											"../admin/**",
											"../../admin",
											"../../admin/**",
											"../../../admin",
											"../../../admin/**",
											"../../../../admin",
											"../../../../admin/**"
										],
										"message": "Public routes must not import admin modules (D-08)"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/web/src/components/ui/**"],
			"linter": {
				"rules": {
					"correctness": {
						"useExhaustiveDependencies": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off",
						"noDoubleEquals": "off",
						"noDocumentCookie": "off"
					},
					"a11y": {
						"noLabelWithoutControl": "off",
						"useSemanticElements": "off"
					}
				}
			}
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
